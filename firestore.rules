rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny all requests unless explicitly permitted
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict Tenant Isolation: Only authenticated user can access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow access to all nested subcollections (workers, transactions, meta)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
